### @name = getUser
GET https://api.example.com/users/1

### @assert
# status == 200
# body.$.name == "Alice"
# body.$.email is string
# body.$.roles is array
# body.$.address exists
# body.$.deleted not exists
# duration < 500ms
# header.Content-Type contains "application/json"
# header.X-Request-Id exists

###

### @name = listUsers
GET https://api.example.com/users

### @assert
# status in [200, 201]
# body.$.users[0].name == "Alice"
# body.$.total is number
# header.Content-Type == "application/json"
# duration < 2000ms
